# Configuração do Supabase para o Casamento de Júnior & Hermenegilda
# Configura estas variáveis no painel da Cloudflare (Settings > Variables and Secrets)
SUPABASE_PROJECT_ID=o_teu_project_id_aqui
VITE_SUPABASE_PROJECT_ID=o_teu_project_id_aqui
SUPABASE_URL=https://o_teu_project_id_aqui.supabase.co
VITE_SUPABASE_URL=https://o_teu_project_id_aqui.supabase.co
SUPABASE_PUBLISHABLE_KEY=a_tua_chave_publicavel_aqui
VITE_SUPABASE_PUBLISHABLE_KEY=a_tua_chave_publicavel_aqui
