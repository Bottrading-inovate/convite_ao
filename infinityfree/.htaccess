# Configuração de rotas para o InfinityFree
# Evita que o InfinityFree envie para errors.infinityfree.net/errors/404/
ErrorDocument 404 /index.php

RewriteEngine On
RewriteBase /

# Se o ficheiro ou pasta real existir, carrega directamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Encaminha todo o resto para o index.php mantendo o caminho /convite/TOKEN
RewriteRule ^(.*)$ index.php [QSA,L]
